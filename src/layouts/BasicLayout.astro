---
import { Font } from "astro:assets"
import "@/styles/global.css"
import Header from "@/components/header/Header.astro"

const {
  title = "Atlas - descubre capitales del mundo",
  description = "Simple juego para aprender capitales y banderas del mundo",
  protectedPage = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="apple-mobile-web-app-title" content="Atlas app" />
    <meta name="description" content={ description } />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("atlas.theme");
        const theme = savedTheme === "light" || savedTheme === "dark"
          ? savedTheme
          : window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        document.documentElement.dataset.theme = theme;
      } catch {
        document.documentElement.dataset.theme = "light";
      }
    </script>
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-ui" preload />
    <Font cssVariable="--font-sans" preload />
    <title>{title}</title>
    {protectedPage && <script is:inline>
      if (!sessionStorage.getItem("atlas.accessToken")) {
        const next = `${window.location.pathname}${window.location.search}`;
        window.location.replace(`/login?next=${encodeURIComponent(next)}`);
      }
    </script>}
  </head>
  <body>
    <Header/>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
