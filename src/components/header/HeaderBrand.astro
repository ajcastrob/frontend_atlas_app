---
interface Props {
  linkLogo?: string
  nameBrand?: string
}

const {
  linkLogo = "/assets/icons/logo.svg#atlas",
  nameBrand = "Atlas",
} = Astro.props
---

<style>
/* Marca */
.header__brand {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--color-ink);
  text-decoration: none;
  transition: color 0.2s ease;
}

.header__brand:hover {
  color: var(--color-brand);
}

.header__logo {
  display: block;
  flex: none;
  width: 32px;
  height: 32px;
}

.header__title {
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 700;
  line-height: 16px;
  letter-spacing: 1.68px;
  text-transform: uppercase;
  white-space: nowrap;
}

/* Foco accesible */
.header__brand:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 4px;
}

/* Escritorio */
@media (min-width: 768px) {
  .header__brand {
    gap: 16px;
  }
}
</style>

<a class="header__brand" href="/" aria-label={`${nameBrand} - Inicio`}>
  <svg class="header__logo" viewBox="0 0 32 32" aria-hidden="true">
    <use href={linkLogo}></use>
  </svg>
  <span class="header__title">{nameBrand}</span>
</a>
