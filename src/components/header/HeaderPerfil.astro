<style>
/* Perfil de usuario */
.header__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 32px;
  height: 32px;
  border: 1px solid var(--color-ink);
  border-radius: 0;
  background: transparent;
  color: var(--color-ink);
  text-decoration: none;
  transition:
    transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
    background-color 0.2s ease;
}

.header__cta:hover {
  background: var(--color-ink);
  color: #fff;
  transform: translateY(-1px);
}

.header__cta:active {
  transform: translateY(1px);
}

.header__cta:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 3px;
}

.header__cta-icon {
  display: block;
  width: 12px;
  height: 12px;
  transition: transform 0.2s ease;
}

/* Escritorio */
@media (min-width: 768px) {
  .header__cta {
    background: transparent;
    color: var(--color-ink);
  }

  .header__cta:hover {
    background: var(--color-ink);
    transform: translateY(-1px);
  }
}
</style>

<a class="header__cta" href="#" aria-label="Perfil del usuario">
  <svg class="header__cta-icon" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
    <use href="/assets/icons/user.svg#user"></use>
  </svg>
</a>
