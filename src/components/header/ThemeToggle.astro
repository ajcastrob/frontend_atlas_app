<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    width: 32px;
    padding-inline: 10px;
    border: 1px solid var(--color-ink);
    border-radius: 0;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      transform 0.15s ease;
  }

  .theme-toggle__icon {
    display: block;
    font: 400 20px/1 var(--font-serif);
    transform: translateY(-1px);
  }

  .theme-toggle:hover {
    background: var(--color-ink);
    color: var(--color-on-ink);
  }

  .theme-toggle:active {
    transform: translateY(1px);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (min-width: 768px) {
    .theme-toggle {
      min-height: 34px;
      width: 34px;
    }
  }
</style>

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label="Activar modo oscuro"
  aria-pressed="false"
  title="Activar modo oscuro"
>
  <span class="theme-toggle__icon" data-theme-icon aria-hidden="true">☾</span>
</button>

<script>
  const toggle = document.querySelector("[data-theme-toggle]");
  const icon = document.querySelector("[data-theme-icon]");

  const renderToggle = (theme) => {
    const isDark = theme === "dark";
    const action = isDark ? "Activar modo claro" : "Activar modo oscuro";

    icon.textContent = isDark ? "☀" : "☾";
    toggle.setAttribute("aria-label", action);
    toggle.setAttribute("title", action);
    toggle.setAttribute("aria-pressed", String(isDark));
  };

  if (toggle && icon) {
    renderToggle(document.documentElement.dataset.theme || "light");

    toggle.addEventListener("click", () => {
      const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = nextTheme;
      localStorage.setItem("atlas.theme", nextTheme);
      renderToggle(nextTheme);
    });
  }
</script>
