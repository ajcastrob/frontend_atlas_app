---
import { API_BASE_URL } from "@/lib/constants.js"
---

<style>
  .login {
    display: grid;
    min-height: calc(100svh - var(--header-height));
    place-items: center;
    padding: clamp(40px, 8vw, 104px) var(--page-gutter);
  }

  .login__plate {
    width: min(100%, 460px);
    padding: clamp(30px, 5vw, 54px);
    border: 1px solid var(--color-ink);
    border-top: 5px solid var(--color-brand);
    background: var(--color-panel);
    box-shadow: none;
  }

  .login__kicker,
  .login__error,
  .login__submit {
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .login__kicker {
    margin: 0 0 22px;
    color: var(--color-brand);
    font-size: var(--text-size-small);
    font-weight: 600;
  }

  .login__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-size-large);
    font-weight: 400;
    letter-spacing: var(--tracking-display);
    line-height: 1.05;
  }

  .login__description {
    max-width: 34ch;
    margin: 22px 0 34px;
    color: var(--color-ink-muted);
    font-size: var(--text-size-small);
    line-height: 1.55;
  }

  .login__form {
    display: grid;
    gap: 18px;
  }

  .login__field {
    display: grid;
    gap: 8px;
  }

  .login__label {
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-size-small);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .login__meta {
    margin: 28px 0 0;
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-size-small);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .login__input {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    background: transparent;
    color: var(--color-ink);
    /* Excepción funcional: el suelo del token es 1rem (16px), nunca menos
       (iOS hace zoom al enfocar por debajo de 16px) */
    font: 400 var(--text-size-small)/1.2 var(--font-sans);
  }

  .login__input:focus {
    border-color: var(--color-brand);
    outline: none;
    box-shadow: 0 2px 0 var(--color-brand);
  }

  .login__submit {
    min-height: 50px;
    margin-top: 6px;
    border: 0;
    border-radius: 0;
    background: var(--color-brand);
    color: var(--color-on-brand);
    cursor: pointer;
    font-size: var(--text-size-small);
    font-weight: 600;
    letter-spacing: var(--tracking-caps-wide);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .login__submit:hover:not(:disabled) {
    background: var(--color-accent);
    transform: translateY(-1px);
  }

  .login__submit:disabled {
    cursor: wait;
    opacity: 0.6;
  }

  .login__error {
    min-height: 1.4em;
    margin: 0;
    color: var(--color-danger);
    /* Mensaje largo: sans para legibilidad (excepción al mono en caps) */
    font-family: var(--font-sans);
    font-size: var(--text-size-small);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: normal;
    text-transform: none;
  }
</style>

<main class="login" aria-labelledby="login-title">
  <section class="login__plate">
    <p class="login__kicker">Atlas / Acceso de expedicionario</p>
    <h1 class="login__title" id="login-title">Iniciar sesión</h1>
    <p class="login__description">
      Accede al compendio para consultar las fichas y comenzar una expedición de diez rondas.
    </p>

    <form class="login__form" data-login-form novalidate>
      <label class="login__field">
        <span class="login__label">Usuario</span>
        <input class="login__input" name="username" type="text" autocomplete="username" required />
      </label>

      <label class="login__field">
        <span class="login__label">Contraseña</span>
        <input class="login__input" name="password" type="password" autocomplete="current-password" required />
      </label>

      <p class="login__error" data-login-error role="alert" aria-live="polite"></p>
      <button class="login__submit" type="submit" data-login-submit>Entrar al atlas</button>
    </form>

    <p class="login__meta">Atlas</p>
  </section>
</main>

<script define:vars={{ apiBaseUrl: API_BASE_URL }}>
  const form = document.querySelector("[data-login-form]");
  const errorMessage = document.querySelector("[data-login-error]");
  const submitButton = document.querySelector("[data-login-submit]");

  if (sessionStorage.getItem("atlas.accessToken")) {
    window.location.replace("/game");
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    errorMessage.textContent = "";
    submitButton.disabled = true;
    submitButton.textContent = "Verificando...";

    const formData = new FormData(form);
    try {
      const response = await fetch(`${apiBaseUrl}/login/`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          username: formData.get("username"),
          password: formData.get("password"),
        }),
      });
      const data = await response.json().catch(() => ({}));

      if (!response.ok || !data.token) {
        throw new Error(data.error || "Usuario o contraseña incorrectos.");
      }

      sessionStorage.setItem("atlas.accessToken", data.token);
      sessionStorage.setItem("atlas.refreshToken", data["refresh-token"] || "");
      sessionStorage.setItem("atlas.user", JSON.stringify(data.user || {}));
      const next = new URLSearchParams(window.location.search).get("next") || "/game";
      const safeNext = next.startsWith("/") && !next.startsWith("//") ? next : "/game";
      window.location.replace(safeNext);
    } catch (error) {
      errorMessage.textContent = error.message || "No fue posible iniciar sesión.";
      submitButton.disabled = false;
      submitButton.textContent = "Entrar al atlas";
    }
  });
</script>
