---
const principles = [
  {
    symbol: "◐",
    title: "Mira con atención",
    description: "Las banderas son la primera pista para ubicarte en el mapa.",
  },
  {
    symbol: "✦",
    title: "Responde y avanza",
    description: "Cada capital reconocida suma una nueva referencia a tu recorrido.",
  },
  {
    symbol: "⌖",
    title: "Vuelve cuando quieras",
    description: "La expedición puede crecer con nuevos retos, regiones y niveles.",
  },
]
---

<style>
.hero-features {
  display: grid;
  grid-template-columns: 1fr;
  gap: 34px;
  width: 100%;
  margin-top: clamp(64px, 8vw, 120px);
  padding-top: 26px;
  border-top: 1px solid var(--color-ink);
}

@media (min-width: 900px) {
  .hero-features {
    grid-template-columns: minmax(230px, 0.74fr) minmax(0, 2.26fr);
    gap: clamp(44px, 7vw, 104px);
    align-items: start;
  }
}

.hero-features__intro {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.hero-features__intro p {
  margin: 0;
  color: var(--color-ink-muted);
  font: 14px/1.5 var(--font-sans);
  text-wrap: pretty;
}

.hero-features__intro h2 {
  margin: 0;
  font: 500 28px/1.1 var(--font-serif);
  letter-spacing: -0.025em;
  text-wrap: balance;
}

.hero-features__list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  border-top: 1px solid var(--color-border);
}

.hero-feature-item {
  display: grid;
  grid-template-columns: auto 1fr;
  column-gap: 14px;
  align-content: start;
  padding: 18px 16px 22px 0;
  border-bottom: 1px solid var(--color-border);
}

@media (min-width: 640px) {
  .hero-feature-item {
    min-height: 168px;
    padding: 22px 22px 22px 18px;
    border-right: 1px solid var(--color-border);
  }

  .hero-feature-item:first-child { padding-left: 0; }
  .hero-feature-item:last-child { border-right: 0; padding-right: 0; }
}

.hero-feature-item__symbol {
  display: grid;
  width: 28px;
  height: 28px;
  place-items: center;
  border: 1px solid var(--color-ink);
  color: var(--color-brand);
  font: 600 15px/1 var(--font-serif);
}

.hero-feature-item__content {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.hero-feature-item__title {
  margin: 0;
  color: var(--color-ink);
  font: 600 16px/1.25 var(--font-sans);
}

.hero-feature-item__desc {
  margin: 0;
  color: var(--color-ink-muted);
  font: 14px/1.5 var(--font-sans);
  text-wrap: pretty;
}
</style>

<section class="hero-features" aria-labelledby="how-it-works-title">
  <div class="hero-features__intro">
    <h2 id="how-it-works-title">Aprender también puede sentirse como explorar.</h2>
    <p>Atlas convierte cada consulta en una pequeña decisión sobre el mapa.</p>
  </div>

  <div class="hero-features__list">
    {principles.map((principle) => (
      <article class="hero-feature-item">
        <span class="hero-feature-item__symbol" aria-hidden="true">{principle.symbol}</span>
        <div class="hero-feature-item__content">
          <h3 class="hero-feature-item__title">{principle.title}</h3>
          <p class="hero-feature-item__desc">{principle.description}</p>
        </div>
      </article>
    ))}
  </div>
</section>
