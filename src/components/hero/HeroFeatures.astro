---
const principles = [
  {
    symbol: "◐",
    title: "Mira con atención",
    description: "Las banderas son la primera pista.",
  },
  {
    symbol: "✦",
    title: "Responde y avanza",
    description: "Cada capital reconocida suma una referencia.",
  },
  {
    symbol: "⌖",
    title: "Vuelve cuando quieras",
    description: "La expedición crece con retos, regiones y niveles.",
  },
]
---

<style>
.hero-features {
  display: grid;
  grid-template-columns: 1fr;
  gap: 34px;
  width: 100%;
  margin-top: clamp(64px, 8vw, 120px);
  padding-top: 26px;
  border-top: 1px solid var(--color-ink);
}

@media (min-width: 900px) {
  .hero-features {
    grid-template-columns: minmax(230px, 0.74fr) minmax(0, 2.26fr);
    gap: clamp(44px, 7vw, 104px);
    align-items: start;
  }
}

.hero-features__intro {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.hero-features__intro p {
  margin: 0;
  color: var(--color-ink-subtle);
  font: 400 var(--text-size-small)/1.55 var(--font-sans);
  text-wrap: pretty;
}

.hero-features__intro h2 {
  margin: 0;
  font: 500 var(--text-size-medium)/1.1 var(--font-serif);
  letter-spacing: var(--tracking-medium);
  text-wrap: balance;
}

.hero-features__list {
  display: grid;
  grid-template-columns: 1fr;
  border-top: 1px solid var(--color-border);
}

.hero-feature-item {
  display: grid;
  grid-template-columns: auto 1fr;
  column-gap: 14px;
  align-content: start;
  padding: 18px 16px 22px 0;
  border-bottom: 1px solid var(--color-border);
}

/* 1 columna (movil): sin bordes verticales */
@media (min-width: 640px) {
  .hero-features__list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hero-feature-item {
    min-height: 200px;
    padding: 22px 22px 22px 18px;
  }

  /* 2 columnas: borde vertical solo en los items que tienen vecino a la derecha */
  .hero-feature-item:nth-child(odd):not(:last-child) {
    border-right: 1px solid var(--color-border);
  }

  .hero-feature-item:nth-child(even) {
    border-right: 0;
    padding-right: 0;
  }

  /* Los items de la columna 1 quedan flush left */
  .hero-feature-item:nth-child(odd) {
    padding-left: 0;
  }
}

@media (min-width: 1200px) {
  .hero-features__list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  /* 3 columnas: borde vertical en las dos primeras */
  .hero-feature-item:nth-child(odd):not(:last-child),
  .hero-feature-item:nth-child(even) {
    border-right: 1px solid var(--color-border);
  }

  .hero-feature-item:nth-child(even) {
    padding-right: 22px;
  }

  .hero-feature-item:nth-child(3n) {
    border-right: 0;
    padding-right: 0;
    /* La 3.ª columna recupera el margen izquierdo */
    padding-left: 18px;
  }
}

.hero-feature-item__symbol {
  display: grid;
  width: 28px;
  height: 28px;
  place-items: center;
  border: 1px solid var(--color-ink);
  color: var(--color-ink-muted);
  font: 600 15px/1 var(--font-serif);
}

.hero-feature-item__content {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.hero-feature-item__title {
  margin: 0;
  color: var(--color-ink);
  font: 600 var(--text-size-medium)/1.15 var(--font-sans);
  letter-spacing: -0.01em;
}

.hero-feature-item__desc {
  margin: 0;
  color: var(--color-ink-subtle);
  font: 400 var(--text-size-small)/1.55 var(--font-sans);
  text-wrap: pretty;
}
</style>

<section class="hero-features" aria-labelledby="how-it-works-title">
  <div class="hero-features__intro">
    <h2 id="how-it-works-title">Aprender es explorar.</h2>
    <p>Atlas convierte cada consulta en una decisión.</p>
  </div>

  <div class="hero-features__list">
    {principles.map((principle) => (
      <article class="hero-feature-item">
        <span class="hero-feature-item__symbol" aria-hidden="true">{principle.symbol}</span>
        <div class="hero-feature-item__content">
          <h3 class="hero-feature-item__title">{principle.title}</h3>
          <p class="hero-feature-item__desc">{principle.description}</p>
        </div>
      </article>
    ))}
  </div>
</section>
