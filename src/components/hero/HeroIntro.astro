---
interface Props {
  eyebrow?: string
  title?: string
  description?: string
  ctaPrimaryText?: string
  ctaPrimaryHref?: string
  ctaSecondaryText?: string
  ctaSecondaryHref?: string
}

const {
  eyebrow = "ATLAS DE EXPEDICIONES",
  title = "Cada país abre una ruta.",
  description = "Reconoce su bandera, encuentra su capital.",
  ctaPrimaryText = "EMPEZAR A JUGAR",
  ctaPrimaryHref = "/register",
  ctaSecondaryText = "INICIAR SESIÓN",
  ctaSecondaryHref = "/login",
} = Astro.props
---

<style>
.hero-intro {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 22px;
  max-width: 580px;
}

/* Badge con punto indicador */
.hero-intro__badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono);
  font-size: var(--text-size-small);
  font-weight: 500;
  letter-spacing: var(--tracking-caps);
  line-height: 1.4;
  text-transform: uppercase;
  color: var(--color-ink-subtle);
}

.hero-intro__dot {
  width: 9px;
  height: 9px;
  border: 2px solid var(--color-ink-subtle);
  border-radius: 50%;
}

/* Título principal con tipografía editorial */
.hero-intro__title {
  margin: 0;
  font-family: var(--font-serif);
  font-size: var(--text-size-large);
  font-weight: 500;
  line-height: 0.94;
  letter-spacing: var(--tracking-display-tight);
  max-width: 16ch;
  font-optical-sizing: auto;
  color: var(--color-ink);
  text-wrap: balance;
}

/* Descripción */
.hero-intro__description {
  margin: 0;
  max-width: 40ch;
  font-family: var(--font-sans);
  font-size: var(--text-size-small);
  line-height: 1.6;
  color: var(--color-ink-subtle);
  text-wrap: pretty;
}

/* Acciones principales */
.hero-intro__actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16px;
  margin-top: 16px;
}

.hero-intro__cta-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  min-height: 56px;
  padding-inline: 30px;
  border: 0;
  border-radius: 0;
  background-color: var(--color-brand);
  color: var(--color-on-brand);
  font-family: var(--font-mono);
  font-size: var(--text-size-small);
  font-weight: 600;
  letter-spacing: var(--tracking-caps-wide);
  text-transform: uppercase;
  text-decoration: none;
  transition:
    background-color 0.25s ease,
    transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.hero-intro__cta-primary:hover {
  background-color: var(--color-accent);
  transform: translateY(-1px);
}

.hero-intro__cta-primary:active {
  transform: translateY(1px);
}

.hero-intro__cta-icon {
  width: 14px;
  height: 14px;
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.hero-intro__cta-primary:hover .hero-intro__cta-icon {
  transform: translateX(5px);
}

.hero-intro__cta-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56px;
  padding-inline: 18px;
  border-radius: 0;
  background: transparent;
  border: 1px solid transparent;
  color: var(--color-ink-subtle);
  font-family: var(--font-mono);
  font-size: var(--text-size-small);
  font-weight: 500;
  letter-spacing: var(--tracking-caps);
  text-transform: uppercase;
  text-decoration: none;
  text-underline-offset: 5px;
  transition:
    color 0.2s ease,
    text-decoration-color 0.2s ease;
}

.hero-intro__cta-secondary:hover {
  color: var(--color-ink);
  text-decoration: underline;
  text-decoration-thickness: 1px;
}

.hero-intro__cta-primary:focus-visible,
.hero-intro__cta-secondary:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 3px;
}

@media (min-width: 768px) {
  .hero-intro {
    gap: 24px;
  }
}
</style>

<div class="hero-intro">
  <div class="hero-intro__badge">
    <span class="hero-intro__dot" aria-hidden="true"></span>
    <span>{eyebrow}</span>
  </div>

  <h1 class="hero-intro__title" id="hero-title">{title}</h1>

  <p class="hero-intro__description">{description}</p>

  <div class="hero-intro__actions">
    <a class="hero-intro__cta-primary" href={ctaPrimaryHref}>
      <span>{ctaPrimaryText}</span>
      <svg class="hero-intro__cta-icon" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M2 6h8M6.5 2.5L10 6l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>

    {ctaSecondaryText && (
      <a class="hero-intro__cta-secondary" href={ctaSecondaryHref}>
        {ctaSecondaryText}
      </a>
    )}
  </div>
</div>
