---
interface Props {
  eyebrow?: string
  title?: string
  description?: string
  ctaPrimaryText?: string
  ctaPrimaryHref?: string
  ctaSecondaryText?: string
  ctaSecondaryHref?: string
}

const {
  eyebrow = "COMPENDIO GEOGRÁFICO",
  title = "El mundo en láminas.",
  description = "Adivina la capital. Diez rondas para ponerte a prueba.",
  ctaPrimaryText = "COMENZAR EXPEDICIÓN",
  ctaPrimaryHref = "/game",
  ctaSecondaryText = "O INICIAR SESIÓN",
  ctaSecondaryHref = "#",
} = Astro.props
---

<style>
.hero-intro {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 20px;
}

/* Badge con punto indicador */
.hero-intro__badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-ink-muted);
}

.hero-intro__dot {
  width: 7px;
  height: 7px;
  border-radius: var(--radius-pill);
  background-color: var(--color-brand);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-brand) 20%, transparent);
  animation: pulse-dot 2.5s ease-in-out infinite;
}

@keyframes pulse-dot {
  0%, 100% {
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-brand) 25%, transparent);
  }
  50% {
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-brand) 10%, transparent);
  }
}

/* Título principal con tipografía editorial */
.hero-intro__title {
  margin: 0;
  font-family: var(--font-serif);
  font-size: clamp(2.25rem, 1.5rem + 3.2vw, 4.25rem);
  font-weight: 400;
  line-height: 1.06;
  letter-spacing: -0.02em;
  color: var(--color-ink);
  text-wrap: balance;
}

/* Descripción */
.hero-intro__description {
  margin: 0;
  max-width: 48ch;
  font-family: var(--font-sans);
  font-size: clamp(1rem, 0.95rem + 0.35vw, 1.15rem);
  line-height: 1.6;
  color: var(--color-ink-muted);
  text-wrap: pretty;
}

/* Acciones principales */
.hero-intro__actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16px;
  margin-top: 12px;
}

.hero-intro__cta-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  height: 48px;
  padding-inline: 24px;
  border-radius: var(--radius-sm);
  background-color: var(--color-ink);
  color: #ffffff;
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-decoration: none;
  box-shadow: 0 2px 4px rgb(0 0 0 / 0.1);
  transition:
    background-color 0.25s ease,
    transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
    box-shadow 0.25s ease;
}

.hero-intro__cta-primary:hover {
  background-color: var(--color-brand);
  transform: translateY(-2px);
  box-shadow: 0 8px 20px color-mix(in srgb, var(--color-brand) 35%, transparent);
}

.hero-intro__cta-primary:active {
  transform: translateY(0) scale(0.98);
}

.hero-intro__cta-icon {
  width: 12px;
  height: 12px;
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.hero-intro__cta-primary:hover .hero-intro__cta-icon {
  transform: translateX(4px);
}

.hero-intro__cta-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 48px;
  padding-inline: 16px;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--color-ink-muted);
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: color 0.2s ease, border-color 0.2s ease;
}

.hero-intro__cta-secondary:hover {
  color: var(--color-ink);
  border-bottom-color: var(--color-ink);
}

.hero-intro__cta-primary:focus-visible,
.hero-intro__cta-secondary:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 3px;
}

@media (min-width: 768px) {
  .hero-intro {
    gap: 24px;
  }
}
</style>

<div class="hero-intro">
  <div class="hero-intro__badge">
    <span class="hero-intro__dot" aria-hidden="true"></span>
    <span>{eyebrow}</span>
  </div>

  <h1 class="hero-intro__title" id="hero-title">{title}</h1>

  <p class="hero-intro__description">{description}</p>

  <div class="hero-intro__actions">
    <a class="hero-intro__cta-primary" href={ctaPrimaryHref}>
      <span>{ctaPrimaryText}</span>
      <svg class="hero-intro__cta-icon" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M2 6h8M6.5 2.5L10 6l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>

    {ctaSecondaryText && (
      <a class="hero-intro__cta-secondary" href={ctaSecondaryHref}>
        {ctaSecondaryText}
      </a>
    )}
  </div>
</div>
