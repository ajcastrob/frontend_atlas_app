<style>
.expedition-board {
  position: relative;
  display: grid;
  width: 100%;
  min-height: 590px;
  padding: clamp(20px, 3vw, 32px);
  overflow: hidden;
  isolation: isolate;
  grid-template-rows: auto 1fr auto;
  background: var(--color-board);
  color: var(--color-board-ink);
}

.expedition-board::before {
  position: absolute;
  inset: 0;
  z-index: -1;
  border: 1px solid var(--color-ink);
  background: linear-gradient(135deg, rgb(255 255 255 / 0.06), transparent 42%);
  content: "";
  pointer-events: none;
}

.board__header,
.board__footer,
.board__globe {
  position: relative;
  z-index: 1;
}

.board__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding-bottom: 18px;
  border-bottom: 1px solid rgb(255 255 255 / 0.34);
  font: 600 var(--text-size-small)/1.4 var(--font-mono);
  letter-spacing: var(--tracking-caps);
  text-transform: uppercase;
}

.board__header span:last-child {
  color: #c8d9ff;
}

.board__globe {
  display: grid;
  min-height: 372px;
  place-items: center;
  overflow: hidden;
}

.board__globe img {
  display: block;
  width: min(100%, 520px);
  height: auto;
  mix-blend-mode: screen;
  object-fit: contain;
}

.board__footer {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 14px;
  align-items: center;
  padding-top: 18px;
  border-top: 1px solid rgb(255 255 255 / 0.34);
}

.board__marker {
  display: grid;
  width: 38px;
  height: 38px;
  place-items: center;
  border: 1px solid rgb(255 255 255 / 0.65);
  color: var(--color-marker);
  font: 700 18px/1 var(--font-serif);
}

.board__footer p {
  max-width: 34ch;
  margin: 0;
  color: #d8e1f4;
  font: 400 var(--text-size-small)/1.45 var(--font-sans);
  text-wrap: pretty;
}

@media (max-width: 640px) {
  .expedition-board { min-height: 480px; }
  .board__globe { min-height: 290px; }
  .board__globe img { width: min(116%, 470px); }
}
</style>

<section class="expedition-board" aria-label="Mesa de juego cartográfica">
  <div class="board__header">
    <span>Mesa de exploración</span>
    <span>Elige una ruta</span>
  </div>

  <div class="board__globe" aria-hidden="true">
    <img src="/assets/hero-atlas-globe.png" alt="" />
  </div>

  <div class="board__footer">
    <span class="board__marker" aria-hidden="true">✦</span>
    <p>Mapamundi</p>
  </div>
</section>
